# Copy to .env and replace the values between < >: docker-compose.yml reads .env.
MARIADB_DATABASE=<database name>
MARIADB_USER=<MariaDB user>
MARIADB_USER_PASSWORD=<MariaDB user password>
MARIADB_ROOT_PASSWORD=<MariaDB root password>
WP_URL=<domain, e.g. login.42.fr>
WP_TITLE=<site title>
WP_ADMIN=<WordPress admin user, without "admin" in the name>
WP_ADMIN_PASSWORD=<admin password>
WP_ADMIN_EMAIL=<admin email>
WP_USER=<second WordPress user>
WP_USER_PASSWORD=<second user password>
WP_USER_EMAIL=<second user email>
WP_USER_ROLE=<second user role, e.g. author>
